// Cloudflare Pages (static assets only). `pages_build_output_dir` marks this as
// a Pages project; do not add `main` or a functions/ directory, which would
// turn it into a Worker / Pages Functions deployment.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "region-indonesia",
  "compatibility_date": "2026-09-23",
  "pages_build_output_dir": "./build/client"
}
